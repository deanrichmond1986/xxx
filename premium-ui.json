{
  "profile": "product-admin",
  "sourceRoots": ["front", "docs"],
  "locale": "ru-RU",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Scrollbar", "Toast"],
  "requiredCommands": ["syntax", "sync", "browser"],
  "commands": {
    "syntax": "node --check front/public/js/app.js && node --check docs/demo-api.js",
    "sync": "python3 scripts/sync_frontend.py --check",
    "browser": "python3 tests/verify_ui.py"
  },
  "evidence": { "failurePaths": "tests/verify_ui.py" }
}
